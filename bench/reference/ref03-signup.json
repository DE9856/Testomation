{
 "spec_version": 1,
 "id": "ref03-signup",
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/register"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Your Name"
   },
   "value": {
    "$faker": "internet.username",
    "as": "name"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Sign up"
   }
  },
  {
   "action": "expect",
   "target": {
    "role": "navigation"
   },
   "assert": "hasText",
   "value": {
    "$var": "name"
   }
  }
 ]
}