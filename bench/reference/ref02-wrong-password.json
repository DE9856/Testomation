{
 "spec_version": 1,
 "id": "ref02-wrong-password",
 "flow": "Try to log in as alice with a wrong password; an error is shown and the user stays on the login page.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": "definitely-wrong"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "expect",
   "target": {
    "text": "Wrong email/password combination"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "assert": "url",
   "value": "/#/login"
  }
 ]
}