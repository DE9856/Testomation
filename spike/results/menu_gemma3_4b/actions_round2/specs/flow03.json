{
 "spec_version": 1,
 "id": "flow03",
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username.",
 "_observe_after": 1,
 "steps": [
  {
   "action": "goto",
   "url": "/#/register"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Your Name"
   },
   "value": {
    "$faker": "person.firstName",
    "as": "name"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password",
    "as": "password"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Sign up"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "paragraph",
    "nth": 0
   },
   "state": "visible"
  },
  {
   "action": "check",
   "target": {
    "role": "paragraph",
    "nth": 0
   }
  },
  {
   "action": "check",
   "target": {
    "role": "paragraph",
    "nth": 1
   }
  },
  {
   "action": "goto",
   "url": "/#/settings"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "paragraph",
    "nth": 2
   },
   "state": "visible"
  }
 ]
}