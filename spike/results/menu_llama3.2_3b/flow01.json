{
 "spec_version": 1,
 "id": "flow01",
 "flow": "Log in as alice; the navigation bar then shows her username 'alice'.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.username",
    "as": "alice"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "paragraph",
    "nth": 0
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/profile/alice"
  },
  {
   "action": "expect",
   "target": {
    "role": "link",
    "name": "Alice's post 3 Post 3 by alice Read more... design postgres"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "link",
    "name": "Alice's post 2 Post 2 by alice Read more... postgres react"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "button",
    "name": "\uf141 ( 1 )"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "link",
    "name": "Alice's post 1 Post 1 by alice Read more... playwright react"
   },
   "assert": "visible"
  }
 ]
}