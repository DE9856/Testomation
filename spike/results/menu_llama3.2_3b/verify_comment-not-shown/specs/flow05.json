{
 "spec_version": 1,
 "id": "flow05",
 "flow": "As alice, open the article \"Dave's post 3\" and post a comment; the comment appears on the page.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Post Comment"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Comment"
   },
   "value": {
    "$faker": "internet.username",
    "as": "alice"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Post Comment"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "paragraph",
    "nth": 1
   },
   "state": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "main"
   },
   "assert": "hasText",
   "value": {
    "$var": "alice"
   }
  },
  {
   "action": "expect",
   "target": {
    "role": "heading",
    "name": "Dave's post 3"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "heading",
    "name": "Heading"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "text": "alice"
   },
   "assert": "visible"
  }
 ]
}