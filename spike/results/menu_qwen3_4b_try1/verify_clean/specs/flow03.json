{
 "spec_version": 1,
 "id": "flow03",
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "goto",
   "url": "/#/register"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Your Name"
   },
   "value": {
    "$faker": "internet.username"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Sign up"
   }
  },
  {
   "action": "expect",
   "target": {
    "text": "Luella67"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "text": "Articles not available."
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "heading",
    "name": "Popular Tags"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "link",
    "name": "\uf12c New Article"
   },
   "assert": "visible"
  }
 ]
}