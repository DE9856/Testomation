{
 "spec_version": 1,
 "id": "flow02",
 "flow": "Try to log in as alice with a wrong password; an error is shown and the user stays on the login page.",
 "_observe_after": 1,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$secret": "ALICE_EMAIL"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  }
 ]
}