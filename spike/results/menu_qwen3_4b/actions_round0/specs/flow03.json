{
 "spec_version": 1,
 "id": "flow03",
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username.",
 "_observe_after": 1,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "gen1"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password",
    "as": "gen2"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "goto",
   "url": "/#/register"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Your Name"
   },
   "value": {
    "$faker": "internet.username",
    "as": "gen3"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "gen4"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password",
    "as": "gen5"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Sign up"
   }
  }
 ]
}