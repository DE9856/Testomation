{
 "spec_version": 1,
 "id": "flow03",
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username.",
 "_observe_after": 1,
 "steps": [
  {
   "action": "goto",
   "url": "/#/"
  },
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Name"
   },
   "value": {
    "$faker": "internet.username",
    "as": "name"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/"
  }
 ]
}