{
 "spec_version": 1,
 "id": "flow10",
 "flow": "As alice, change her bio in settings to some generated text; her profile page then shows that bio.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/settings"
  },
  {
   "action": "fill",
   "target": {
    "text": "Article Title",
    "nth": 1
   },
   "value": {
    "$faker": "internet.username",
    "as": "Article Title"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "What's this article about?",
    "nth": 1
   },
   "value": {
    "$faker": "internet.email",
    "as": "What's this article about?"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "Write your article (in markdown)",
    "nth": 1
   },
   "value": {
    "$faker": "lorem.sentence",
    "as": "Write your article (in markdown)"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "Enter tags",
    "nth": 1
   },
   "value": {
    "$faker": "internet.email",
    "as": "Enter tags"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Update Settings"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "listitem",
    "nth": 1
   },
   "state": "visible"
  },
  {
   "action": "fill",
   "target": {
    "text": "Short bio about you",
    "nth": 1
   },
   "value": {
    "$faker": "lorem.paragraph",
    "as": "Short bio about you"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Update Settings"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "listitem",
    "nth": 1
   },
   "state": "visible"
  },
  {
   "action": "check",
   "target": {
    "text": "Short bio about you",
    "nth": 1
   }
  }
 ]
}