{
 "spec_version": 1,
 "id": "flow05",
 "flow": "As alice, open the article \"Dave's post 3\" and post a comment; the comment appears on the page.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "link",
    "name": "dave"
   },
   "state": "visible"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Write a comment..."
   },
   "value": {
    "$faker": "lorem.paragraph",
    "as": "comment"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Post Comment"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "paragraph",
    "nth": 1
   },
   "state": "visible"
  }
 ]
}