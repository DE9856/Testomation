{
 "spec_version": 1,
 "id": "flow04",
 "flow": "As alice, publish a new article with a title, description, body and two tags; the article page then shows the title.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/editor"
  },
  {
   "action": "fill",
   "target": {
    "text": "Article Title",
    "nth": 1
   },
   "value": {
    "$faker": "internet.username",
    "as": "title"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "What's this article about?",
    "nth": 2
   },
   "value": {
    "$faker": "lorem.sentence",
    "as": "description"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "Write your article (in markdown)",
    "nth": 3
   },
   "value": {
    "$faker": "lorem.paragraph",
    "as": "body"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "Enter tags",
    "nth": 1
   },
   "value": {
    "$faker": "internet.email",
    "as": "tag1"
   }
  },
  {
   "action": "fill",
   "target": {
    "text": "Enter tags",
    "nth": 2
   },
   "value": {
    "$faker": "internet.email",
    "as": "tag2"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Publish Article"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "link",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "check",
   "target": {
    "text": "Title",
    "nth": 1
   }
  }
 ]
}