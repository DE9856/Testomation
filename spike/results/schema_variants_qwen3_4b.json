    {
      "parsed": true,
      "valid": true,
      "errors": [],
      "spec": {
        "spec_version": 1,
        "id": "publish-article-and-check-title",
        "steps": [
          {
            "action": "goto",
            "url": "/login"
          },
          {
            "action": "fill",
            "target": {
              "role": "Email",
              "name": "Email"
            },
            "value": "alice@con:conduit.test"
          },
          {
            "action": "fill",
            "target": {
              "role": "Password",
              "name": "Password"
            },
            "value": "$secret:ALICE_PASSWORD"
          },
          {
            "action": "click",
            "target": {
              "role": "button",
              "name": "Sign in"
            }
          },
          {
            "action": "goto",
            "url": "/editor"
          },
          {
            "action": "fill",
            "target": {
              "role": "Article Title",
              "name": "Article Title"
            },
            "value": "Test Article"
          },
          {
            "action": "fill",
            "target": {
              "role": "What's this article about?",
              "name": "What's this article about?"
            },
            "value": "This is a test article."
          },
          {
            "action": "fill",
            "target": {
              "role": "Write your article (in markdown)",
              "name": "Write your article (in markdown)"
            },
            "value": "# Test Article\nThis is a test article."
          },
          {
            "action": "fill",
            "target": {
              "role": "Enter tags",
              "name": "Enter tags"
            },
            "value": "tag1, tag2"
          },
          {
            "action": "click",
            "target": {
              "role": "button",
              "name": "Publish Article"
            }
          },
          {
            "action": "goto",
            "url": "/profile/alice"
          },
          {
            "action": "check",
            "target": {
              "role": "h1",
              "name": "Title"
            }
          }
        ]
      }
    }
