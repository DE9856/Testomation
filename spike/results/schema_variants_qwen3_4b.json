          },
          {
            "action": "fill",
            "target": {
              "role": "input",
              "name": "Password"
            },
            "value": "faker_password"
          },
          {
            "action": "click",
            "target": {
              "role": "button",
              "name": "Sign up"
            }
          },
          {
            "action": "wait_for",
            "target": {
              "role": "link",
