{
  "A_original": [
    {
      "parsed": true,
      "valid": true,
      "errors": [],
      "spec": {
        "spec_version": 1,
        "id": "login_check_alice_username",
        "steps": [
          {
            "action": "goto",
            "url": "/login"
          },
          {
            "action": "fill",
            "target": {
              "role": "input",
              "name": "Email"
            },
            "value": "alice@conduit.test"
          },
          {
            "action": "fill",
            "target": {
              "role": "input",
              "name": "Password"
            },
            "value": "$secret:ALICE_PASSWORD"
          },
          {
            "action": "click",
            "target": {
              "role": "button",
              "name": "Sign in"
            }
          },
          {
            "action": "wait_for",
            "target": {
              "role": "navigation",
              "name": "Navigation"
            },
            "state": "visible"
          },
          {
            "action": "check",
            "target": {
              "role": "link",
              "name": "alice"
            }
          }
        ],
        "requirement": "The username 'alice' should appear in the navigation bar after logging in as alice."
      }
    },
    {
      "parsed": true,
