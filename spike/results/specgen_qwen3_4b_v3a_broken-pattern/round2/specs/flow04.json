{
 "spec_version": 1,
 "id": "flow04",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "New Article"
   },
   "state": "visible"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "New Article"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Article Title"
   },
   "value": {
    "$faker": "internet.username"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "What's this article about?"
   },
   "value": {
    "$faker": "internet.password"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Write your article (in markdown)"
   },
   "value": {
    "$faker": "lorem.paragraph"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Enter tags"
   },
   "value": {
    "$faker": "internet.username"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Enter tags"
   },
   "value": {
    "$faker": "internet.username"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Publish Article"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "Dave's post 3"
   },
   "state": "visible"
  },
  {
   "action": "expect",
   "assert": "visible",
   "target": {
    "role": "heading",
    "name": "Dave's post 3"
   }
  }
 ],
 "flow": "As alice, publish a new article with a title, description, body and two tags; the article page then shows the title."
}