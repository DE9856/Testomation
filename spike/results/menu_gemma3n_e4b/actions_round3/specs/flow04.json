{
 "spec_version": 1,
 "id": "flow04",
 "flow": "As alice, publish a new article with a title, description, body and two tags; the article page then shows the title.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/editor"
  },
  {
   "action": "fill",
   "target": {
    "text": "Article Title"
   },
   "value": "My First Article"
  },
  {
   "action": "fill",
   "target": {
    "text": "What's this article about?"
   },
   "value": "This is the content of my first article."
  },
  {
   "action": "fill",
   "target": {
    "text": "Write your article (in markdown)"
   },
   "value": "## This is a heading\nThis is the body of the article."
  },
  {
   "action": "fill",
   "target": {
    "text": "Enter tags"
   },
   "value": "playwright, react"
  },
  {
   "action": "click",
   "target": {
    "text": "Publish Article"
   }
  }
 ]
}