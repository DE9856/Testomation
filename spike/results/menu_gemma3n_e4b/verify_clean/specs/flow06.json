{
 "spec_version": 1,
 "id": "flow06",
 "flow": "On the home page, click the 'react' tag under Popular Tags; the feed then only lists articles tagged 'react'.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/ "
  },
  {
   "action": "click",
   "target": {
    "text": "react"
   }
  },
  {
   "action": "expect",
   "target": {
    "text": "react"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "button",
    "name": "\uf219 react"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "text": "playwright"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "text": "postgres"
   },
   "assert": "visible"
  }
 ]
}