{
 "spec_version": 1,
 "id": "flow05",
 "flow": "As alice, open the article \"Dave's post 3\" and post a comment; the comment appears on the page.",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Write a comment..."
   },
   "value": "Great post!"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Post Comment"
   }
  },
  {
   "action": "expect",
   "target": {
    "text": "October 4, 2026"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "text": "Comment from alice"
   },
   "assert": "visible"
  }
 ]
}