{
 "spec_version": 1,
 "id": "flow08",
 "flow": "As alice, open 'Your Feed'; it lists articles by bob and carol (whom she follows) and none by dave.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/"
  },
  {
   "action": "goto",
   "url": "/#/ "
  },
  {
   "action": "wait_for",
   "target": {
    "text": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "check",
   "target": {
    "text": "Bob's post 3 Post 3 by bob Read more... playwright testing"
   }
  },
  {
   "action": "check",
   "target": {
    "text": "Carol's post 3 Post 3 by carol Read more... design testing"
   }
  },
  {
   "action": "check",
   "target": {
    "text": "Dave's post 3 Post 3 by dave Read more... design testing"
   }
  }
 ]
}