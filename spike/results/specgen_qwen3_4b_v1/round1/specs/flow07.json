{
 "spec_version": 1,
 "id": "flow07",
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/article/dave-s-post-3"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Favorite ( 0 )"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Favorite ( 1 )"
   },
   "state": "visible"
  },
  {
   "action": "expect",
   "assert": "visible",
   "target": {
    "role": "button",
    "name": "Favorite ( 1 )"
   }
  }
 ],
 "flow": "As alice, favorite the article \"Dave's post 3\"; its favorite count goes from 0 to 1."
}