{
 "spec_version": 1,
 "id": "flow09",
 "flow": "Without logging in, open bob's profile; it lists his three articles.",
 "_observe_after": 1,
 "steps": [
  {
   "action": "goto",
   "url": "/#/"
  },
  {
   "action": "goto",
   "url": "/#/profile/bob"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "Bob's post 3"
   },
   "state": "visible"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "Bob's post 2"
   },
   "state": "visible"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "Bob's post 1"
   },
   "state": "visible"
  }
 ]
}