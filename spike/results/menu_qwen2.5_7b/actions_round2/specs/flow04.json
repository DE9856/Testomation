{
 "spec_version": 1,
 "id": "flow04",
 "flow": "As alice, publish a new article with a title, description, body and two tags; the article page then shows the title.",
 "_observe_after": 6,
 "steps": [
  {
   "action": "goto",
   "url": "/#/login"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": "alice@conduit.test"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$secret": "ALICE_PASSWORD"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Login"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "button",
    "name": "Your Feed"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/"
  },
  {
   "action": "goto",
   "url": "/#/editor"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Article Title"
   },
   "value": {
    "$faker": "internet.username",
    "as": "title"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "What's this article about?"
   },
   "value": {
    "$faker": "lorem.sentence",
    "as": "description"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Write your article (in markdown)"
   },
   "value": {
    "$faker": "lorem.paragraph",
    "as": "body"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Enter tags"
   },
   "value": "tag1,tag2"
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Publish Article"
   }
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "title"
   },
   "state": "visible"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "title"
   },
   "state": "visible"
  },
  {
   "action": "goto",
   "url": "/#/article/title"
  },
  {
   "action": "wait_for",
   "target": {
    "role": "heading",
    "name": "title"
   },
   "state": "visible"
  }
 ]
}