{
 "spec_version": 1,
 "id": "flow03",
 "steps": [
  {
   "action": "goto",
   "url": "/#/register"
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Your Name"
   },
   "value": {
    "$faker": "internet.username",
    "as": "name"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Email"
   },
   "value": {
    "$faker": "internet.email",
    "as": "email"
   }
  },
  {
   "action": "fill",
   "target": {
    "role": "textbox",
    "name": "Password"
   },
   "value": {
    "$faker": "internet.password"
   }
  },
  {
   "action": "click",
   "target": {
    "role": "button",
    "name": "Sign up"
   }
  },
  {
   "action": "expect",
   "target": {
    "role": "link",
    "name": "name"
   },
   "assert": "visible"
  },
  {
   "action": "expect",
   "target": {
    "role": "heading",
    "name": "name"
   },
   "assert": "visible"
  }
 ],
 "flow": "Sign up a brand-new user with generated data; afterwards the navigation bar shows the new username."
}